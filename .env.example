# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# Numeric ID of your Telegram channel (negative number for channels, e.g. -1003909158778)
TELEGRAM_CHANNEL_ID=

# Optional: print scoring breakdown next to each item in the digest (useful for tuning)
# SHOW_SCORES=1

# Optional: dry-run prints the digest to stdout instead of sending to Telegram
# DRY_RUN=1
